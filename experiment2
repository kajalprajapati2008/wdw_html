<!DOCTYPE html>
<html>
<head>
    <title>Global Daily News</title>
    <style>
        body {
            font-family: Arial;
            margin: 20px;
        }

        header {
            text-align: center;
            background-color: lightgray;
            padding: 10px;
        }

        nav {
            text-align: center;
            padding: 10px;
        }

        img {
            width: 320px;
            height: 200px;
        }

        iframe, video {
            width: 320px;
            height: 180px;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Global Daily News</h1>
        <p>Your Trusted Source for Latest Updates</p>
    </header>

    <!-- Navigation Menu -->
    <nav>
        <a href="#world">World</a> |
        <a href="#sports">Sports</a> |
        <a href="#entertainment">Entertainment</a> |
        <a href="#podcast">Podcast</a> |
        <a href="#contact">Contact</a>
    </nav>

    <hr>

    <!-- World News -->
    <h3 id="world">World News</h3>
    <p>Today's top headline: Global leaders meet to discuss climate change initiatives.</p>

    <img src="https://placehold.co/320x200?text=World+News"
         alt="World News Image">

    <p>
        <a href="https://www.bbc.com" target="_blank">
            Read more on BBC
        </a>
    </p>

    <hr>

    <!-- Sports Section -->
    <h3 id="sports">Sports Update</h3>
    <p>Highlights of yesterday's football match with thrilling last-minute goals!</p>

    <!-- YouTube Video -->
    <iframe
        src="https://www.youtube.com/embed/aqz-KE-bpKQ"
        title="YouTube Video"
        allowfullscreen>
    </iframe>

    <hr>

    <!-- Entertainment Section -->
    <h3 id="entertainment">Entertainment Buzz</h3>
    <p>New movie trailer released today. Fans are excited!</p>

    <!-- Video -->
    <video controls>
        <source src="sample-video.mp4" type="video/mp4">
        Your browser does not support video.
    </video>

    <hr>

    <!-- Podcast Section -->
    <h2 id="podcast">News Podcast</h2>
    <p>Listen to today's top headlines:</p>

    <audio controls>
        <source src="sample-audio.mp3" type="audio/mpeg">
        Your browser does not support audio.
    </audio>

    <hr>

    <!-- Footer -->
    <h3 id="contact">Contact Us</h3>
    <p>Email: info@globalnews.com</p>
    <p>&copy; 2025 Global Daily News</p>

</body>
</html>